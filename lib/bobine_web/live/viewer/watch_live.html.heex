<ViewerLayout.viewer_layout
  organization={@organization}
  current_viewer={@current_viewer}
  impersonating_viewer={@impersonating_viewer}
  current_path={~p"/watch/#{@video.id}"}
  theme={@theme}
  flash={@flash}
>
  <div class="sv-watch-layout" data-test="watch-page">
    <%!-- Player + Queue row --%>
    <div class="sv-watch-player-row">
      <div class="sv-watch-player-col">
        <div class="sv-player-wrapper">
          <ViewerComponents.video_player
            video={@video}
            resume_position={@resume_position}
          />
          <button
            :if={@current_viewer}
            phx-click="toggle_queue"
            class="sv-queue-toggle-chevron"
            data-test="queue-chevron-toggle"
            aria-label={if @queue_open, do: "Close queue", else: "Open queue"}
          >
            <.icon
              name={
                if @queue_open, do: "hero-chevron-double-left", else: "hero-chevron-double-right"
              }
              class="size-5"
              aria-hidden="true"
            />
          </button>
        </div>
      </div>

      <%!-- Queue panel --%>
      <aside
        :if={@current_viewer}
        class={["sv-queue-panel", @queue_open && "open"]}
        data-test="queue-panel"
      >
        <div class="sv-queue-header">
          <h3>Queue ({@queue_count})</h3>
          <button
            phx-click="toggle_queue"
            class="sv-btn sv-btn-ghost"
            data-test="toggle-queue-btn"
            aria-label={if @queue_open, do: "Close queue", else: "Open queue"}
          >
            <.icon name="hero-x-mark" class="size-5" aria-hidden="true" />
          </button>
        </div>

        <div
          :if={@queue_items != []}
          id="queue-list"
          phx-hook="QueueSortable"
          class="sv-queue-list"
          data-test="queue-list"
        >
          <div
            :for={{item, index} <- Enum.with_index(@queue_items)}
            class={["sv-queue-item", index == 0 && "next-up"]}
            data-id={item.video_id}
            data-test={"queue-item-#{item.video_id}"}
          >
            <div class="sv-queue-drag-handle" data-test="queue-drag-handle" aria-hidden="true">
              <.icon name="hero-bars-3" class="size-4" />
            </div>
            <.link
              navigate={~p"/watch/#{item.video_id}"}
              class="sv-queue-item-link"
              data-test={"queue-link-#{item.video_id}"}
            >
              <img
                :if={item.video && item.video.mux_playback_id}
                src={"https://image.mux.com/#{item.video.mux_playback_id}/thumbnail.webp?width=160&height=90&fit_mode=smartcrop"}
                alt={item.video.title}
                class="sv-queue-thumb"
              />
              <div class="sv-queue-item-info">
                <span class="sv-queue-item-title">{item.video.title}</span>
                <span :if={item.video.duration} class="sv-queue-item-duration">
                  {format_duration(item.video.duration)}
                </span>
              </div>
            </.link>
            <button
              phx-click="remove_from_queue"
              phx-value-video-id={item.video_id}
              class="sv-queue-remove"
              data-test={"queue-remove-#{item.video_id}"}
              aria-label={"Remove #{item.video.title} from queue"}
            >
              <.icon name="hero-x-mark" class="size-4" aria-hidden="true" />
            </button>
          </div>
        </div>

        <div :if={@queue_items != []} class="sv-queue-footer">
          <button
            phx-click="clear_queue"
            class="sv-btn sv-btn-ghost"
            style="width: 100%"
            data-test="clear-queue-btn"
          >
            Clear queue
          </button>
        </div>

        <div :if={@queue_items == []} class="sv-queue-empty" data-test="queue-empty">
          <p>Your queue is empty</p>
          <p>Browse content and add videos to build your watch queue.</p>
        </div>
      </aside>
    </div>

    <div class="sv-watch-below">
      <%!-- 2-col details/actions grid: text on the left, action stack on the
           right. Stacks on narrow viewports. --%>
      <div class="sv-watch-info">
        <div class="sv-video-meta" data-test="video-detail">
          <%!-- Series breadcrumb (only for episodes) --%>
          <.link
            :if={@episode_context}
            navigate={~p"/series/#{@episode_context.series.slug}"}
            class="sv-series-breadcrumb"
            data-test="series-breadcrumb"
          >
            {@episode_context.series.title}
          </.link>

          <h1 class="sv-video-title" data-test="video-title">{@video.title}</h1>

          <p :if={@episode_context} class="sv-episode-label" data-test="episode-label">
            Season {@episode_context.season_number},
            Episode {@episode_context.episode_number} of {@episode_context.total_episodes}
          </p>

          <div :if={@video.duration && !@episode_context} class="sv-video-badges">
            <ViewerComponents.badge label={format_duration(@video.duration)} />
          </div>

          <p
            :if={@video.description}
            class="sv-video-desc"
            data-test="video-description"
          >
            {@video.description}
          </p>
        </div>

        <div class="sv-video-actions" data-test="video-actions">
          <%!-- Queue navigation --%>
          <button
            :if={@go_back_available}
            phx-click="go_back"
            class="sv-btn sv-btn-secondary sv-go-back-btn"
            data-test="go-back-btn"
            aria-label="Go back to previous video"
          >
            <.icon name="hero-backward" class="size-5 mr-1" aria-hidden="true" /> Go back
          </button>

          <button
            :if={@current_viewer && @queue_count > 0}
            phx-click="skip_to_next"
            class="sv-btn sv-btn-secondary"
            data-test="skip-next-btn"
            aria-label="Skip to next video in queue"
          >
            <.icon name="hero-forward" class="size-5 mr-1" aria-hidden="true" /> Next
          </button>

          <%!-- Engagement actions --%>
          <button
            :if={@current_viewer}
            phx-click="add_to_queue"
            phx-value-video-id={@video.id}
            class="sv-btn sv-btn-secondary"
            data-test="add-to-queue-btn"
            aria-label="Add to queue"
          >
            <.icon name="hero-queue-list" class="size-5 mr-1" aria-hidden="true" /> Queue
          </button>

          <button
            :if={@current_viewer}
            phx-click="toggle_favorite"
            class={["sv-btn sv-btn-secondary", @is_favorited && "active"]}
            data-test="favorite-btn"
            aria-pressed={to_string(@is_favorited)}
            aria-label={if @is_favorited, do: "Remove from favorites", else: "Add to favorites"}
          >
            <.icon
              name={if @is_favorited, do: "hero-heart-solid", else: "hero-heart"}
              class="size-5 mr-1"
              aria-hidden="true"
            /> Favorite
          </button>

          <button
            :if={@current_viewer}
            phx-click="toggle_watchlist"
            class={["sv-btn sv-btn-secondary", @in_watchlist && "active"]}
            data-test="watchlist-btn"
            aria-pressed={to_string(@in_watchlist)}
            aria-label={if @in_watchlist, do: "Remove from watchlist", else: "Add to watchlist"}
          >
            <.icon
              name={if @in_watchlist, do: "hero-bookmark-solid", else: "hero-bookmark"}
              class="size-5 mr-1"
              aria-hidden="true"
            /> Watchlist
          </button>
        </div>
      </div>

      <%!-- Season section (only for episodes) --%>
      <%= if @episode_context do %>
        <section class="sv-season-section" data-test="season-section">
          <h2 class="sv-row-title" data-test="season-section-heading">
            Season {@selected_season.season_number}: {@selected_season.title}
          </h2>
          <%!-- Season selector dropdown --%>
          <div class="sv-season-header">
            <form phx-change="switch_season" data-test="season-selector">
              <label for="season-select" class="sr-only">Select season</label>
              <select name="season_id" id="season-select" class="sv-season-dropdown">
                <option
                  :for={season <- @seasons}
                  value={season.id}
                  selected={season.id == @selected_season.id}
                >
                  {season.title}
                  {if season.id != @selected_season.id,
                    do: " · #{season.episode_count} episodes",
                    else: ""}
                </option>
              </select>
            </form>

            <div
              :if={@current_viewer}
              class="sv-queue-dropdown-wrapper"
              phx-click-away="close_queue_dropdown"
            >
              <button
                type="button"
                phx-click="toggle_queue_dropdown"
                phx-value-target-id={@selected_season.id}
                class="sv-season-queue-btn"
                data-test="season-queue-btn"
                aria-haspopup="true"
                aria-expanded={to_string(@queue_dropdown_open == @selected_season.id)}
              >
                + Add season to queue ▾
              </button>

              <div
                :if={@queue_dropdown_open == @selected_season.id}
                class="sv-queue-dropdown"
                data-test={"queue-dropdown-season-#{@selected_season.id}"}
                role="menu"
              >
                <button
                  type="button"
                  phx-click="add_to_queue"
                  phx-value-id={@selected_season.id}
                  phx-value-type="season"
                  phx-value-position="end"
                  data-test={"queue-add-end-#{@selected_season.id}"}
                >
                  Add to end
                </button>
                <button
                  type="button"
                  phx-click="add_to_queue"
                  phx-value-id={@selected_season.id}
                  phx-value-type="season"
                  phx-value-position="beginning"
                  data-test={"queue-add-beginning-#{@selected_season.id}"}
                >
                  Add to beginning
                </button>
              </div>
            </div>
          </div>

          <%!-- Episode list --%>
          <div
            class="sv-episode-list"
            id="episode-list"
            phx-hook="ScrollToCurrentEpisode"
            data-current-video-id={@video.id}
            data-test="episode-list"
          >
            <%= for ep <- @episodes do %>
              <% is_current = ep.video_id == @video.id %>
              <% progress = Map.get(@viewer_progress, ep.video_id) %>
              <% is_completed = progress && progress.completed %>
              <% has_progress =
                progress && is_number(progress.position) && progress.position > 0 &&
                  !is_completed %>
              <% progress_pct =
                if has_progress && is_number(progress.duration) && progress.duration > 0,
                  do: progress.position / progress.duration * 100,
                  else: 0 %>
              <div
                class={[
                  "sv-episode-row",
                  is_current && "current",
                  is_completed && "completed"
                ]}
                data-test={"episode-row-#{ep.video_id}"}
              >
                <%!-- Episode number / status indicator --%>
                <div
                  class="sv-episode-number"
                  data-test={"episode-status-#{ep.video_id}"}
                >
                  <%= cond do %>
                    <% is_current -> %>
                      <span class="sv-now-playing-icon" aria-label="Now playing">▶</span>
                    <% is_completed -> %>
                      <span class="sv-completed-icon" aria-label="Completed">✓</span>
                    <% true -> %>
                      <span>{ep.episode_number}</span>
                  <% end %>
                </div>

                <%!-- Thumbnail with progress bar --%>
                <div class="sv-episode-thumb-container">
                  <img
                    :if={ep.video && ep.video.mux_playback_id}
                    src={"https://image.mux.com/#{ep.video.mux_playback_id}/thumbnail.webp?width=200&height=112&fit_mode=smartcrop"}
                    alt={ep.title || ep.video.title}
                    class="sv-episode-thumb"
                  />
                  <div
                    :if={has_progress}
                    class="sv-episode-progress-bar"
                    style={"width: #{progress_pct}%"}
                    data-test={"episode-progress-#{ep.video_id}"}
                  />
                </div>

                <%!-- Episode info --%>
                <div class="sv-episode-info">
                  <button
                    phx-click="play_episode"
                    phx-value-video-id={ep.video_id}
                    class="sv-episode-title"
                    data-test={"episode-link-#{ep.video_id}"}
                  >
                    {ep.title || ep.video.title}
                  </button>
                  <div class="sv-episode-meta">
                    <span :if={ep.video.duration}>{format_duration(ep.video.duration)}</span>
                    <%= cond do %>
                      <% is_completed -> %>
                        <span class="sv-episode-watched-badge">Watched</span>
                      <% has_progress -> %>
                        <span>
                          · {format_duration(ep.video.duration - progress.position)} remaining
                        </span>
                      <% true -> %>
                        <span></span>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <%!-- Related content (for standalone videos only) --%>
      <div
        :if={@episode_context == nil && fill_rows(@related_videos, 4) != []}
        class="sv-row"
        style="margin-top: 48px;"
      >
        <h2 class="sv-row-title">More from {@organization.name}</h2>
        <div class="sv-browse-grid">
          <ViewerComponents.content_card
            :for={video <- fill_rows(Enum.take(@related_videos, 8), 4)}
            video={video}
            size="grid"
            current_viewer={@current_viewer}
            favorited_ids={@favorited_ids}
            watchlisted_ids={@watchlisted_ids}
            queued_ids={@queued_ids}
          />
        </div>
      </div>
    </div>
  </div>

  <%!-- Confirmation dialog when adding a season the viewer has progress in --%>
  <div
    :if={@queue_season_confirm}
    class="sv-dialog-overlay"
    phx-click-away="cancel_add_season"
    data-test="queue-season-confirm"
    role="presentation"
  >
    <div
      class="sv-dialog"
      data-test="queue-season-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="queue-season-dialog-title"
    >
      <h3 id="queue-season-dialog-title">Add to queue</h3>
      <p>
        You've started watching <strong>{@queue_season_confirm.season.title}</strong>. Which episodes would you like to add?
      </p>
      <div class="sv-dialog-actions">
        <button
          type="button"
          phx-click="confirm_add_season"
          phx-value-mode="all"
          class="sv-dialog-btn-primary"
          data-test="confirm-add-all"
        >
          All episodes
        </button>
        <button
          type="button"
          phx-click="confirm_add_season"
          phx-value-mode="unwatched"
          class="sv-dialog-btn-secondary"
          data-test="confirm-add-unwatched"
        >
          Only unwatched
        </button>
        <button
          type="button"
          phx-click="cancel_add_season"
          class="sv-dialog-btn-cancel"
          data-test="confirm-cancel"
        >
          Cancel
        </button>
      </div>
    </div>
  </div>
</ViewerLayout.viewer_layout>
