<%= case @page_mode do %>
  <% :platform_marketing -> %>
    <.platform_marketing subscriber_demo_url={@subscriber_demo_url} />
  <% :org_landing -> %>
    <div
      :if={Marquee.SubscriberDemo.enabled?(@organization)}
      class="bg-stone-950 px-6 py-8 text-center text-white"
    >
      <p class="mb-4">The Workshop · Subscriber demo. No account or payment needed.</p>
      <.link
        href={~p"/demo/subscriber"}
        method="post"
        data-test="subscriber-demo-entry"
        class="btn btn-primary min-h-11"
      >
        Try the subscriber demo
      </.link>
    </div>
    <%= if @landing_sections == [] do %>
      <.org_landing organization={@organization} />
    <% else %>
      <ViewerLayout.viewer_layout
        organization={@organization}
        current_path="/"
        theme={@theme}
        flash={@flash}
      >
        <div class="sv-landing" data-test="landing-page">
          <.landing_section
            :for={section <- @landing_sections}
            section={section}
            organization={@organization}
          />
        </div>
      </ViewerLayout.viewer_layout>
    <% end %>
  <% :org_home -> %>
    <ViewerLayout.viewer_layout
      organization={@organization}
      current_viewer={@current_viewer}
      impersonating_viewer={@impersonating_viewer}
      current_path="/"
      theme={@theme}
      flash={@flash}
    >
      <.viewer_home_body
        hero_slides={@hero_slides}
        hero_auto_advance_ms={@hero_auto_advance_ms}
        rows={@rows}
        current_viewer={@current_viewer}
        favorited_ids={@favorited_ids}
        watchlisted_ids={@watchlisted_ids}
        queued_ids={@queued_ids}
      />
    </ViewerLayout.viewer_layout>
<% end %>
