<%= case @page_mode do %>
  <% :platform_marketing -> %>
    <.platform_marketing
      subscriber_demo_url={@subscriber_demo_url}
      admin_demo_url={@admin_demo_url}
    />
  <% :org_landing -> %>
    <%= if @landing_sections == [] and not @subscriber_demo_landing? do %>
      <.org_landing organization={@organization} />
    <% else %>
      <ViewerLayout.viewer_layout
        organization={@organization}
        current_path="/"
        theme={@theme}
        flash={@flash}
      >
        <div
          class={["sv-landing", @subscriber_demo_landing? && "sv-demo-landing"]}
          data-test={
            if @subscriber_demo_landing?, do: "subscriber-demo-landing", else: "landing-page"
          }
        >
          <header
            :if={@subscriber_demo_landing? and is_nil(@demo_entry_hero)}
            class="sv-demo-intro"
          >
            <p class="sv-demo-eyebrow">{@organization.name} / An invitation to explore</p>
            <h1>Something worth discovering.</h1>
            <.subscriber_demo_entry organization={@organization} />
          </header>
          <.landing_section
            :for={section <- @landing_sections}
            :if={
              not (@subscriber_demo_landing? and section.section_type == :plan_display and
                     section.config["plans"] == [])
            }
            section={section}
            organization={@organization}
            demo_entry={@subscriber_demo_landing? and section == @demo_entry_hero}
            anonymous_demo={@subscriber_demo_landing?}
          />
        </div>
      </ViewerLayout.viewer_layout>
    <% end %>
  <% :org_home -> %>
    <ViewerLayout.viewer_layout
      organization={@organization}
      current_viewer={@current_viewer}
      impersonating_viewer={@impersonating_viewer}
      current_path="/"
      theme={@theme}
      flash={@flash}
    >
      <.viewer_home_body
        hero_slides={@hero_slides}
        hero_auto_advance_ms={@hero_auto_advance_ms}
        rows={@rows}
        current_viewer={@current_viewer}
        favorited_ids={@favorited_ids}
        watchlisted_ids={@watchlisted_ids}
        queued_ids={@queued_ids}
      />
    </ViewerLayout.viewer_layout>
<% end %>
