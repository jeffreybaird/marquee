<MarqueeWeb.Components.AdminLayout.admin_layout
  current_path={@current_path}
  trial_status={@trial_status}
  organization={@organization}
  current_user={@current_user}
  impersonating={@impersonating}
  flash={@flash}
>
  <%!-- Persistent MuxUploader hook — lives outside the sheet so it survives sheet close --%>
  <div id="mux-uploader" phx-hook="MuxUploader" class="hidden"></div>

  <%!-- First-visit walkthrough for this page --%>
  <div
    id="content-page-tour"
    phx-hook="PageTour"
    data-tour-page="content"
    data-auto-start={to_string(@show_page_tour)}
    data-tour-brand={@organization.name}
    class="hidden"
  >
  </div>

  <%= if @viewing_video do %>
    <.video_detail
      video={@viewing_video}
      video_tags={@video_tags}
      all_tags={@all_tags}
      editing={@editing_video}
      show_tag_picker={@show_tag_picker}
      tag_search={@tag_search}
      can_manage={@can_manage}
      portrait_thumbnail_state={
        MarqueeWeb.Admin.ImageUploadHandlers.upload_state(
          @image_uploads,
          "video_portrait_thumbnail",
          @viewing_video.id
        )
      }
      landscape_thumbnail_state={
        MarqueeWeb.Admin.ImageUploadHandlers.upload_state(
          @image_uploads,
          "video_landscape_thumbnail",
          @viewing_video.id
        )
      }
    />
  <% else %>
    <.video_list
      videos={@videos}
      videos_tags_map={@videos_tags_map}
      search={@search}
      filter_tag_ids={@filter_tag_ids}
      page={@page}
      total_pages={@total_pages}
      can_manage={@can_manage}
      show_upload_modal={@show_upload_modal}
      upload_files={@upload_files}
      uploading={@uploading}
      upload_total={@upload_total}
      upload_completed={@upload_completed}
      upload_percent={@upload_percent}
      row_tag_picker_video_id={@row_tag_picker_video_id}
      all_tags={@all_tags}
      tag_search={@tag_search}
    />
  <% end %>
</MarqueeWeb.Components.AdminLayout.admin_layout>
