{
  "schema_version": 2,
  "source_globs": [
    "*.sh",
    "**/*.sh",
    "*.py",
    "**/*.py",
    ".github/workflows/*.yml",
    ".gitea/workflows/*.yml",
    "*.ex",
    "**/*.ex",
    "*.exs",
    "**/*.exs",
    "*.heex",
    "**/*.heex",
    "*.eex",
    "**/*.eex",
    "*.js",
    "**/*.js",
    "*.ts",
    "**/*.ts",
    "*.css",
    "**/*.css",
    "bin/check-features"
  ],
  "test_globs": [
    "test/**",
    "tests/**",
    "spec/**",
    "**/*_test.py",
    "**/*_test.exs",
    "**/*_spec.rb",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.js",
    "**/*.spec.js",
    "**/*.test.tsx",
    "**/*.spec.tsx",
    "**/*.test.jsx",
    "**/*.spec.jsx",
    "features/**"
  ]
}
